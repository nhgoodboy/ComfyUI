# =============================================================================
# ComfyUI 工作流处理服务器 - 环境配置模板
# =============================================================================
#
# 此文件是 .env 配置文件的模板，用于部署时复制并修改
# 复制此文件为 .env 并根据实际环境填写配置值
#
# 使用方法：
# 1. 复制此文件: cp env.template .env
# 2. 根据实际环境修改 .env 文件中的配置值
# 3. 确保敏感信息（如ComfyUI地址）正确配置
#
# =============================================================================

# =============================================================================
# 应用基础配置
# =============================================================================

# 应用名称和版本
APP_NAME=ComfyUI Workflow Server
APP_VERSION=2.0.0

# 服务器监听配置
# HOST: 服务器绑定的IP地址，0.0.0.0表示绑定所有网络接口
# PORT: 服务器监听端口
HOST=0.0.0.0
PORT=8000

# 工作进程数（生产环境建议设为CPU核心数）
# 开发环境建议设为1，生产环境可根据CPU核心数调整
WORKERS=1

# 调试模式（生产环境必须设为false）
# true: 启用调试模式，显示详细错误信息和API文档
# false: 生产模式，隐藏敏感信息
DEBUG=false

# 运行环境（development, production）
# development: 开发环境，启用更详细的日志
# production: 生产环境，优化性能和安全
ENVIRONMENT=development

# 日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL）
# DEBUG: 显示所有日志信息（仅开发环境推荐）
# INFO: 显示一般信息和错误（推荐）
# WARNING: 仅显示警告和错误
# ERROR: 仅显示错误信息
LOG_LEVEL=INFO

# 日志格式（json, text）
# json: JSON格式日志，便于日志分析工具处理
# text: 文本格式日志，便于人工阅读
LOG_FORMAT=json

# CORS配置 - 允许的跨域源
# 开发环境可设为*，生产环境应指定具体域名
# 示例：https://your-frontend.com,https://admin.your-company.com
# 留空表示不允许跨域请求
CORS_ORIGINS=*

# =============================================================================
# ComfyUI后端配置
# =============================================================================

# ComfyUI服务器地址
# 请根据实际ComfyUI服务器部署情况修改
# 本地部署: localhost 或 127.0.0.1
# Docker部署: 容器名称或内网IP
# 远程部署: 实际服务器IP地址
COMFYUI_HOST=localhost
COMFYUI_PORT=8188

# ComfyUI连接超时（秒）
# 建议值：300秒（5分钟），网络较慢时可适当增加
COMFYUI_TIMEOUT=300

# ComfyUI最大重试次数
# 当连接失败时的重试次数，建议值：3次
COMFYUI_MAX_RETRIES=3

# ComfyUI重试延迟（秒）
# 重试之间的等待时间，建议值：5秒
COMFYUI_RETRY_DELAY=5

# ComfyUI客户端ID（可选，留空自动生成）
# 用于标识客户端连接，通常留空让系统自动生成
COMFYUI_CLIENT_ID=

# =============================================================================
# 文件存储配置
# =============================================================================

# 用户上传目录
# 用于存放用户上传的图片文件
UPLOADS_DIR=uploads

# 图片输出目录
# 用于存放ComfyUI生成的图片文件
OUTPUTS_DIR=outputs

# 工作流配置目录
# 用于存放工作流JSON配置文件
WORKFLOWS_DIR=workflows

# 系统配置目录
# 用于存放系统配置YAML文件
CONFIGS_DIR=configs

# 最大文件大小（字节）- 10MB
# 限制上传文件的最大大小，10485760字节 = 10MB
# 可根据需要调整，注意服务器磁盘空间
MAX_FILE_SIZE=10485760

# 允许的文件扩展名（逗号分隔）
# 限制可上传的文件类型，仅允许图片格式
# 添加新格式时请确保ComfyUI支持该格式
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,bmp,webp

# =============================================================================
# 部署说明
# =============================================================================
#
# 1. 开发环境快速启动：
#    - 确保ComfyUI在本地8188端口运行
#    - 保持默认配置即可
#    - 运行: python start.py
#
# 2. 生产环境部署：
#    - 修改 COMFYUI_HOST 为实际ComfyUI服务器地址
#    - 设置 DEBUG=false
#    - 设置 ENVIRONMENT=production
#    - 设置 CORS_ORIGINS 为具体的前端域名
#    - 根据服务器配置调整 WORKERS 数量
#
# 3. Docker部署：
#    - 确保ComfyUI容器可访问
#    - 配置正确的网络和卷挂载
#    - 参考项目中的 Dockerfile
#
# =============================================================================