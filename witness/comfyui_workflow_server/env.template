# =============================================================================
# ComfyUI工作流服务器 - 银行级安全环境配置模板
# =============================================================================
# 
# 这是具有五层安全防护架构的ComfyUI工作流服务器的完整配置模板
# 
# 安全防护层级：
# 第1层：IP白名单控制
# 第2层：API密钥认证  
# 第3层：请求签名验证
# 第4层：速率限制保护
# 第5层：JWT令牌验证
#
# 使用说明：
# 1. 复制此文件为 .env
# 2. 根据部署环境修改配置值
# 3. 生产环境必须设置所有安全密钥
# 4. 开发环境可使用默认值但不安全
#
# =============================================================================

# =============================================================================
# 🔐 核心安全配置 - 银行级防护
# =============================================================================

# 安全防护总开关 - 控制是否启用五层安全防护
# 设为false时将禁用所有安全中间件，仅适用于开发环境
# 生产环境强烈建议保持为true
SECURITY_ENABLED=true

# API密钥 - 用于接口身份验证和签名验证（必需，64字符十六进制）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=your-64-char-api-secret-key-change-in-production

# JWT密钥 - 用于用户令牌签名（必需，64字符十六进制）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-64-char-jwt-secret-key-change-in-production

# 数据加密密钥 - 用于敏感数据加密（可选，64字符十六进制）
ENCRYPTION_KEY=your-64-char-encryption-key-change-in-production

# =============================================================================
# 🌐 网络安全配置
# =============================================================================

# IP白名单 - 仅允许这些IP访问（必需）
# 格式：IP地址或CIDR网段，用逗号分隔
# 开发环境示例：127.0.0.1,::1,192.168.0.0/24
# 生产环境示例：10.0.1.100,10.0.1.101,203.0.113.10
ALLOWED_IPS=127.0.0.1,::1,192.168.0.0/24,10.0.0.0/8

# 强制HTTPS（生产环境强烈建议）
ENFORCE_HTTPS=false

# CORS配置 - 允许的跨域源
# 开发环境可设为空或*，生产环境应指定具体域名
# 示例：https://your-frontend.com,https://admin.your-company.com
CORS_ORIGINS=

# =============================================================================
# ⏱️ 安全时间配置
# =============================================================================

# 请求签名超时时间（秒）- 防重放攻击
# 推荐值：300秒（5分钟），网络延迟高可调整为600
SIGNATURE_TIMEOUT=300

# JWT令牌过期时间（分钟）
# 推荐值：60分钟，高安全环境可设为30分钟
TOKEN_EXPIRY_MINUTES=60

# =============================================================================
# 🚦 速率限制配置 - 防DDoS攻击
# =============================================================================

# 每个IP每分钟最大请求数
# 推荐值：60，高流量环境可适当提高
RATE_LIMIT_PER_IP=60

# 每个请求每分钟最大请求数
# 推荐值：30，可根据业务需求调整
RATE_LIMIT_PER_REQUEST=30

# =============================================================================
# 🚀 应用基础配置
# =============================================================================

# 应用名称和版本
APP_NAME=ComfyUI Workflow Server
APP_VERSION=2.0.0

# 服务器监听配置
HOST=0.0.0.0
PORT=8000

# 工作进程数（生产环境建议设为CPU核心数）
WORKERS=1

# 调试模式（生产环境必须设为false）
DEBUG=false

# 日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_LEVEL=INFO

# 日志文件路径（可选）
LOG_FILE=logs/app.log

# =============================================================================
# 🎨 ComfyUI后端配置
# =============================================================================

# ComfyUI服务器地址
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188

# ComfyUI连接超时（秒）
COMFYUI_TIMEOUT=300

# ComfyUI最大重试次数
COMFYUI_MAX_RETRIES=3

# ComfyUI重试延迟（秒）
COMFYUI_RETRY_DELAY=5

# ComfyUI客户端ID（可选，留空自动生成）
COMFYUI_CLIENT_ID=

# =============================================================================
# 📁 文件存储配置
# =============================================================================

# 用户上传目录
UPLOADS_DIR=uploads

# 图片输出目录
OUTPUTS_DIR=outputs

# 工作流配置目录
WORKFLOWS_DIR=workflows

# 系统配置目录
CONFIGS_DIR=configs

# 最大文件大小（字节）- 10MB
MAX_FILE_SIZE=10485760

# 允许的文件扩展名（逗号分隔）
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,bmp,webp

# 文件清理保留时间（小时）
FILE_RETENTION_HOURS=24

# =============================================================================
# 🔧 高级配置
# =============================================================================

# 任务超时时间（秒）
TASK_TIMEOUT=300

# 任务清理保留时间（小时）
TASK_RETENTION_HOURS=24

# 最大并发任务数
MAX_CONCURRENT_TASKS=10

# HTTP连接池配置
HTTP_CONNECTION_LIMIT=100
HTTP_CONNECTION_PER_HOST=30

# HTTP超时配置（秒）
HTTP_TIMEOUT_TOTAL=120
HTTP_TIMEOUT_CONNECT=10

# =============================================================================
# 📊 监控和性能配置
# =============================================================================

# 健康检查间隔（秒）
HEALTH_CHECK_INTERVAL=30

# 性能监控启用
PERFORMANCE_MONITORING=true

# 请求日志记录
REQUEST_LOGGING=true

# 慢查询阈值（秒）
SLOW_QUERY_THRESHOLD=5.0

# =============================================================================
# 🏢 客户端和请求配置
# =============================================================================

# 请求ID头部名称
REQUEST_ID_HEADER=x-request-id

# 最小请求ID长度
MIN_REQUEST_ID_LENGTH=3

# 最大请求ID长度
MAX_REQUEST_ID_LENGTH=64

# 每客户端最大任务数
MAX_TASKS_PER_CLIENT=100

# 每客户端最大文件数
MAX_FILES_PER_CLIENT=1000

# 每客户端最大存储空间（字节）- 1GB
MAX_STORAGE_PER_CLIENT=1073741824

# =============================================================================
# 🔄 缓存和数据库配置（可选）
# =============================================================================

# Redis配置（可选，用于分布式缓存）
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=your-redis-password

# 缓存TTL（秒）
CACHE_TTL=3600

# 数据库URL（如果使用数据库）
# DATABASE_URL=sqlite:///app.db

# =============================================================================
# 🛡️ 安全增强选项
# =============================================================================

# 安全Cookie设置
SECURE_COOKIES=true

# 会话安全
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=strict

# 请求体大小限制（字节）
MAX_REQUEST_SIZE=10485760

# 密码复杂度要求（如果有用户注册功能）
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# =============================================================================
# 🌍 国际化配置
# =============================================================================

# 默认语言
DEFAULT_LANGUAGE=zh-CN

# 时区设置
TIMEZONE=Asia/Shanghai

# =============================================================================
# 📧 通知配置（可选）
# =============================================================================

# 邮件配置（用于安全告警）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@example.com
# SMTP_PASSWORD=your-email-password
# SMTP_USE_TLS=true

# 安全告警邮箱
# SECURITY_ALERT_EMAIL=security@your-company.com

# =============================================================================
# 🧪 开发和测试配置
# =============================================================================

# 测试模式（仅开发环境）
TEST_MODE=false

# 开发工具启用
DEV_TOOLS=false

# API文档访问（生产环境建议关闭）
ENABLE_DOCS=false

# =============================================================================
# 📝 配置说明和示例
# =============================================================================

# 生成安全密钥的Python命令：
# python -c "import secrets; print('API_SECRET_KEY=' + secrets.token_hex(32))"
# python -c "import secrets; print('JWT_SECRET_KEY=' + secrets.token_hex(32))"

# 测试JWT令牌生成（开发环境）：
# python examples/secure_client_example.py generate-config

# 生产环境安全检查清单：
# □ 所有SECRET_KEY都已更改
# □ DEBUG=false
# □ ALLOWED_IPS已正确配置
# □ ENFORCE_HTTPS=true
# □ CORS_ORIGINS已限制具体域名
# □ 所有密码和密钥至少32字符
# □ 日志级别设为INFO或WARNING
# □ 性能参数已根据服务器配置调整

# =============================================================================
# 环境特定配置示例
# =============================================================================

# 开发环境配置示例：
# DEBUG=true
# LOG_LEVEL=DEBUG
# ALLOWED_IPS=127.0.0.1,::1,192.168.0.0/24
# ENFORCE_HTTPS=false
# ENABLE_DOCS=true

# 生产环境配置示例：
# DEBUG=false
# LOG_LEVEL=WARNING
# ALLOWED_IPS=10.0.1.100,10.0.1.101
# ENFORCE_HTTPS=true
# ENABLE_DOCS=false
# WORKERS=4

# Docker环境配置示例：
# HOST=0.0.0.0
# UPLOADS_DIR=/app/data/uploads
# OUTPUTS_DIR=/app/data/outputs
# LOG_FILE=/app/logs/app.log

# =============================================================================
# 🚨 安全警告
# =============================================================================

# 重要提醒：
# 1. 生产环境必须更改所有默认密钥
# 2. 不要在代码中硬编码密钥
# 3. 定期轮换安全密钥（建议3-6个月）
# 4. 监控安全日志，及时发现异常
# 5. 备份配置文件但保护敏感信息
# 6. 使用强密码和多因素认证
# 7. 定期进行安全审计和渗透测试

# =============================================================================
# 结束
# ============================================================================= 