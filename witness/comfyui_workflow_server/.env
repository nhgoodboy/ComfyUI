# Style Transform API 环境配置示例
# 复制此文件并重命名为 `.env`，然后根据实际部署环境修改变量。

# ============= 基础配置 =============
# 应用名称和版本
APP_NAME=Style Transform API
APP_VERSION=1.0.0

# 服务器监听地址与端口
HOST=0.0.0.0
PORT=8000
WORKERS=1

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# 调试模式开关
DEBUG=true

# ============= ComfyUI 配置 =============
# ComfyUI 服务地址（含协议、主机和端口）
COMFYUI_BASE_URL=http://localhost:6006

# ComfyUI 客户端ID（可选，留空自动生成）
COMFYUI_CLIENT_ID=

# 工作流文件目录
WORKFLOW_DIR=./app/workflows

# ============= 安全配置 =============
# API密钥（生产环境强烈建议设置）
API_KEY=your-secret-api-key-here

# CORS配置
CORS_ORIGINS=["*"]

# ============= 任务配置 =============
# 任务超时时间（秒）
TASK_TIMEOUT=300

# 任务清理保留时间（小时）
TASK_RETENTION_HOURS=24

# ============= 文件配置 =============
# 最大图像文件大小（字节）
MAX_IMAGE_SIZE=10485760

# 允许的图像类型
ALLOWED_IMAGE_TYPES=["image/jpeg", "image/png", "image/webp"]

# ============= 中间件配置 =============
# 限流配置（每分钟请求数）
RATE_LIMIT_PER_MINUTE=60

# 用户限流配置（每分钟请求数）
USER_RATE_LIMIT_PER_MINUTE=10

# ============= 监控配置 =============
# 健康检查间隔（秒）
HEALTH_CHECK_INTERVAL=30

# 性能监控启用
PERFORMANCE_MONITORING=true

# ============= 高级配置 =============
# 连接池配置
HTTP_CONNECTION_LIMIT=100
HTTP_CONNECTION_PER_HOST=30

# 超时配置（秒）
HTTP_TIMEOUT_TOTAL=120
HTTP_TIMEOUT_CONNECT=10

# 重试配置
HTTP_MAX_RETRIES=3
HTTP_RETRY_DELAY=1.0 