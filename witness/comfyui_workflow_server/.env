# =============================================================================
# ComfyUI 工作流处理服务器
# =============================================================================

# =============================================================================
# 🚀 应用基础配置
# =============================================================================

# 应用名称和版本
APP_NAME=ComfyUI Workflow Server
APP_VERSION=2.0.0

# 服务器监听配置
HOST=0.0.0.0
PORT=8000

# 工作进程数（生产环境建议设为CPU核心数）
WORKERS=1

# 调试模式（生产环境必须设为false）
DEBUG=false

# 运行环境（development, production）
ENVIRONMENT=development

# 日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_LEVEL=INFO

# 日志格式（json, text）
LOG_FORMAT=json

# CORS配置 - 允许的跨域源
# 开发环境可设为*，生产环境应指定具体域名
# 示例：https://your-frontend.com,https://admin.your-company.com
CORS_ORIGINS=*

# =============================================================================
# 🎨 ComfyUI后端配置
# =============================================================================

# ComfyUI服务器地址
COMFYUI_HOST=172.31.32.1
COMFYUI_PORT=8188

# ComfyUI连接超时（秒）
COMFYUI_TIMEOUT=300

# ComfyUI最大重试次数
COMFYUI_MAX_RETRIES=3

# ComfyUI重试延迟（秒）
COMFYUI_RETRY_DELAY=5

# ComfyUI客户端ID（可选，留空自动生成）
COMFYUI_CLIENT_ID=

# =============================================================================
# 📁 文件存储配置
# =============================================================================

# 用户上传目录
UPLOADS_DIR=uploads

# 图片输出目录
OUTPUTS_DIR=outputs

# 工作流配置目录
WORKFLOWS_DIR=workflows

# 系统配置目录
CONFIGS_DIR=configs

# 最大文件大小（字节）- 10MB
MAX_FILE_SIZE=10485760

# 允许的文件扩展名（逗号分隔）
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,bmp,webp

# =============================================================================
# 🔧 工作流任务配置
# =============================================================================

# 最大并发工作流任务数
MAX_CONCURRENT_WORKFLOWS=3

# 工作流任务超时时间（秒）
WORKFLOW_TASK_TIMEOUT=300

# 任务状态检查间隔（秒）
WORKFLOW_STATUS_CHECK_INTERVAL=2

# =============================================================================
# 🌐 WebSocket配置
# =============================================================================

# WebSocket连接超时时间（秒）
WEBSOCKET_CONNECTION_TIMEOUT=30

# WebSocket心跳间隔（秒）
WEBSOCKET_PING_INTERVAL=30

# WebSocket心跳超时（秒）
WEBSOCKET_PING_TIMEOUT=10

# WebSocket最大连接数
WEBSOCKET_MAX_CONNECTIONS=100

# =============================================================================
# 📊 监控和清理配置
# =============================================================================

# 健康检查间隔（秒）
HEALTH_CHECK_INTERVAL=30

# 是否启用详细统计
ENABLE_DETAILED_STATS=true

# 是否启用自动文件清理
ENABLE_AUTO_CLEANUP=true

# 临时文件保留时间（小时）
TEMP_FILE_RETENTION_HOURS=2

# 输入文件保留时间（天）
INPUT_FILE_RETENTION_DAYS=7

# 输出文件保留时间（天）
OUTPUT_FILE_RETENTION_DAYS=30

# 清理任务执行间隔（小时）
CLEANUP_INTERVAL_HOURS=6

# =============================================================================
# 🔒 安全配置
# =============================================================================

# 是否启用请求频率限制
ENABLE_RATE_LIMITING=false

# 每分钟最大请求数
MAX_REQUESTS_PER_MINUTE=60

# 是否检查文件MIME类型
CHECK_FILE_MIME_TYPE=true

# 最大文件名长度
MAX_FILENAME_LENGTH=255