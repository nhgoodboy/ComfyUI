    # ComfyUI工作流服务器连接配置（简化版）
COMFYUI_WORKFLOW_SERVER_URL=http://127.0.0.1:8000

# Web应用自身配置
APP_HOST=0.0.0.0
APP_PORT=8080
PUBLIC_HOST=127.0.0.1
SESSION_SECRET_KEY=your-web-app-session-secret-key-change-in-production
LOG_LEVEL=INFO
DEBUG=false

# 应用基本配置
APP_NAME=Web Image Transform
APP_VERSION=2.0.0

# 文件配置
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_FILE_SIZE=10485760

# 日志配置
LOG_FILE=logs/web_transform.log

# WebSocket配置
WS_HEARTBEAT_INTERVAL=30

# 安全配置
SECRET_KEY=your-secret-key-here

# 用户配置
DEFAULT_USER_ID=web_user